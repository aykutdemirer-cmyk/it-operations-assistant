# Kök `.env.example` — kök `docker-compose.yml`'in okuduğu değerler
# (Docker Compose, aynı dizindeki `.env` dosyasını OTOMATİK okur).
# `deploy.sh`/`deploy.ps1` bu dosyadan gerçek bir `.env` üretir; rastgele
# üretilebilecek değerleri (SECRET_KEY'ler, POSTGRES_PASSWORD) SİZİN
# yerinize üretip doldururlar — burada elle doldurmanız GEREKMEZ.
#
# Bu dosya `apps/api/.env.example`'ın YERİNE GEÇMEZ — backend'in kendi
# (SNMP hedefi, guacd loopback override'ı gibi) geliştirme-odaklı
# opsiyonel değişkenleri orada kalmaya devam ediyor. Buradaki değişkenler
# yalnızca KONTEYNERLEŞTİRİLMİŞ (`docker-compose.yml`) production
# dağıtımı için gereklidir.

# ---- PostgreSQL --------------------------------------------------
POSTGRES_USER=itops
POSTGRES_PASSWORD=
POSTGRES_DB=itops

# ---- PAM/RBAC (Faz 46) — İKİSİ DE ZORUNLU ------------------------
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_TOKEN_TTL_MINUTES=480
# Üretmek için: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAM_VAULT_SECRET_KEY=

# ---- İlk ADMIN hesabı (yalnızca `users` tablosu BOMBOŞKEN etkili) ---
# `deploy.sh`/`deploy.ps1` GÜÇLÜ, rastgele bir parola üretip BİR KEZ
# ekranda gösterir — "admin123" gibi tahmin edilebilir bir varsayılan
# ASLA kullanılmaz (bkz. DEPLOYMENT.md §5).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Web servisi ---------------------------------------------------
# Frontend'in host üzerinde dinleyeceği port (konteyner içi hep 3000).
WEB_HTTP_PORT=80

# ============================================================
# Aşağıdakiler OPSİYONEL — boş bırakılırsa ilgili özellik "opt-in"
# ilkesiyle sessizce devre dışı kalır (bu projenin 46+ fazdır izlediği
# desen). Gerçek üretim değerlerini kurulumdan SONRA Ayarlar ekranından
# (SMTP/LDAP/vCenter — DB'de saklanır, şifreli) girmeniz de mümkündür;
# oradan girilenler buradakilerin ÖNÜNE geçer.
# ============================================================

# SMTP — bilet e-posta bildirimleri (Faz 65/66).
# SMTP_SERVER=smtp.sirket.local
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=IT Operations Helpdesk
# SMTP_IT_GROUP_EMAIL=
# TICKET_BASE_URL=https://itops.sirket.local

# LDAP/Active Directory — bağlantı bilgilerinin KENDİSİ (host/bind DN/
# parola) burada DEĞİL, kurulum sonrası Ayarlar > Active Directory/LDAP
# ekranından girilir (DB'de Fernet ile şifreli saklanır). Buradaki iki
# değişken yalnızca zamanlanmış senkronizasyon/bind-auth-girişini
# açar/kapatır.
# LDAP_SCHEDULED_SYNC_ENABLED=true
# LDAP_AUTH_ENABLED=false
# LDAP_AUTH_DEFAULT_ROLE=VIEWER
