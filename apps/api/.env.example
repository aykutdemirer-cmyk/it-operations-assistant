DATABASE_URL=postgresql://itops:itops@localhost:5432/itops

# SNMP (Faz 22.2/22.4) — hepsi opsiyonel. Yalnızca kullanıcının açıkça
# verdiği TEK bir gerçek hedefi test etmek için doldurulur; boşsa SNMP
# poll her zaman dürüstçe "not_configured" döner. Gerçek secret
# DEĞERLERİNİ asla commit etmeyin — bu dosya yalnızca bir örnektir
# (bkz. app/snmp/profile_store.py).
# SNMP_TARGET_ASSET_ID=
# SNMP_TARGET_PORT=161
# SNMP_TARGET_TIMEOUT_SECONDS=2.0
# SNMP_TARGET_RETRIES=1
#
# --- v2c (SNMP_TARGET_VERSION=v2c, varsayılan) ---
# SNMP_TARGET_VERSION=v2c
# SNMP_TARGET_COMMUNITY_REF=SNMP_V2C_COMMUNITY
# SNMP_V2C_COMMUNITY=
#
# --- v3 (SNMP_TARGET_VERSION=v3) — noAuthNoPriv için yalnızca USERNAME yeterli ---
# SNMP_TARGET_VERSION=v3
# SNMP_TARGET_USERNAME=
# SNMP_TARGET_AUTH_PROTOCOL=SHA256
# SNMP_TARGET_AUTH_CREDENTIAL_REF=SNMP_V3_AUTH_SECRET
# SNMP_V3_AUTH_SECRET=
# SNMP_TARGET_PRIV_PROTOCOL=AES256
# SNMP_TARGET_PRIV_CREDENTIAL_REF=SNMP_V3_PRIV_SECRET
# SNMP_V3_PRIV_SECRET=

# SNMP Polling Engine (Faz 23) — aynı anda çalışacak maksimum SNMP poll
# sayısı; sınırsız paralel poll yapılmaz. Boşsa güvenli düşük bir
# varsayılan (5) kullanılır.
# SNMP_MAX_CONCURRENCY=5
