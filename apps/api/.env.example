DATABASE_URL=postgresql://itops:itops@localhost:5432/itops

# CORS — normalde SET ETMEYİN. Frontend backend'e Next.js'in kendi
# rewrites() proxy'si üzerinden konuşur (same-origin), bu yüzden
# `http://localhost:3000` çoğu kurulum için yeterlidir. Yalnızca
# frontend'de `NEXT_PUBLIC_API_URL` açıkça mutlak bir adrese set
# edilmişse (ör. ayrı bir host/konteyner) buraya virgülle ayrılmış ek
# origin'ler ekleyin.
# CORS_ADDITIONAL_ORIGINS=http://10.0.213.30:3000

# SNMP (Faz 22.2/22.4) — hepsi opsiyonel. Yalnızca kullanıcının açıkça
# verdiği TEK bir gerçek hedefi test etmek için doldurulur; boşsa SNMP
# poll her zaman dürüstçe "not_configured" döner. Gerçek secret
# DEĞERLERİNİ asla commit etmeyin — bu dosya yalnızca bir örnektir
# (bkz. app/snmp/profile_store.py).
# SNMP_TARGET_ASSET_ID=
# SNMP_TARGET_PORT=161
# SNMP_TARGET_TIMEOUT_SECONDS=2.0
# SNMP_TARGET_RETRIES=1
#
# --- v2c (SNMP_TARGET_VERSION=v2c, varsayılan) ---
# SNMP_TARGET_VERSION=v2c
# SNMP_TARGET_COMMUNITY_REF=SNMP_V2C_COMMUNITY
# SNMP_V2C_COMMUNITY=
#
# --- v3 (SNMP_TARGET_VERSION=v3) — noAuthNoPriv için yalnızca USERNAME yeterli ---
# SNMP_TARGET_VERSION=v3
# SNMP_TARGET_USERNAME=
# SNMP_TARGET_AUTH_PROTOCOL=SHA256
# SNMP_TARGET_AUTH_CREDENTIAL_REF=SNMP_V3_AUTH_SECRET
# SNMP_V3_AUTH_SECRET=
# SNMP_TARGET_PRIV_PROTOCOL=AES256
# SNMP_TARGET_PRIV_CREDENTIAL_REF=SNMP_V3_PRIV_SECRET
# SNMP_V3_PRIV_SECRET=

# SNMP Polling Engine (Faz 23) — aynı anda çalışacak maksimum SNMP poll
# sayısı; sınırsız paralel poll yapılmaz. Boşsa güvenli düşük bir
# varsayılan (5) kullanılır.
# SNMP_MAX_CONCURRENCY=5

# Arka plan SNMP polling worker'ı — backend başladığında otomatik
# başlar, periyodik olarak TÜM asset'leri poll edip "İzleme" sayfasının
# canlı grafik/log akışını besler (bkz. app/snmp/scheduler.py). Yalnızca
# geliştirme/test sırasında istenmeyen gerçek ağ trafiğini önlemek için
# kapatmak isterseniz `false` yapın.
# SNMP_BACKGROUND_POLLING_ENABLED=true
# SNMP_POLL_INTERVAL_SECONDS=30

# PAM/RBAC (Faz 46) — ikisi de ZORUNLU, gerçek üretim değerleri asla bu
# dosyaya/commit'e yazılmaz.
#
# JWT_SECRET_KEY: oturum token'larının imza anahtarı. Eksikse backend
# `app/auth/security.py::_jwt_secret_key()`'de KASITLI olarak hata
# verir (zayıf/varsayılan bir anahtarla sessizce imzalamak yerine).
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=
# JWT_TOKEN_TTL_MINUTES=480
#
# PAM_VAULT_SECRET_KEY: `vault_credentials.encrypted_payload`'ın Fernet
# anahtarı (bkz. app/pam/vault.py) — GERÇEK bir `Fernet.generate_key()`
# çıktısı olmalı, rastgele bir string DEĞİL. Üretmek için:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PAM_VAULT_SECRET_KEY=
#
# BOOTSTRAP_ADMIN_USERNAME / BOOTSTRAP_ADMIN_PASSWORD: `users` tablosu
# BOMBOŞKEN (ilk çalıştırma) backend başlangıcında bir kerelik tek bir
# ADMIN hesabı oluşturur (bkz. app/main.py::_ensure_bootstrap_admin) —
# tablo boş değilse hiçbir etkisi yok. İlk girişten sonra bu satırları
# .env'den SİLİN.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=

# Faz 48 — Guacamole/guacd (Zero-Knowledge web RDP). guacd AYRI bir
# servis (bkz. infra/docker-compose.yml) — Docker/WSL2 kurulup gerçek
# bir guacd konteyneri ile CANLI doğrulandı (bkz. docs/roadmap.md Faz
# 48 notu). Varsayılan guacd portu (4822) resmi Apache Guacamole
# belgelerinde SABİT.
# GUACD_HOST=127.0.0.1
# GUACD_PORT=4822
#
# GUACD_HOST_LOOPBACK_TARGET: bir asset'in IP'si `127.0.0.1`/`localhost`
# olduğunda (backend'in KENDİ makinesi) guacd konteynerinin bunu KENDİ
# loopback'i sanmaması için (Docker ağ izolasyonu — gerçek, canlı testle
# bulunan bir hata) hedef bu isimle DEĞİŞTİRİLİR. Docker Desktop'ta
# host makineye erişim için varsayılan `host.docker.internal` — native
# Linux Docker'da farklı bir ağ kurulumu (ör. `--add-host` ile SABİT bir
# IP) gerekebilir, bu durumda buradan override edin.
# GUACD_HOST_LOOPBACK_TARGET=host.docker.internal

# Faz 49 — LDAP/Active Directory zamanlanmış senkronizasyon worker'ı.
# LDAP bağlantı bilgilerinin kendisi (host/port/base DN/bind DN+parola)
# koda/`.env`'e YAZILMAZ — yalnızca Ayarlar > Active Directory / LDAP
# ekranından `ldap_config` tablosuna (parola şifreli, bkz. app/services/
# ldap.py::encrypt_bind_password) kaydedilir. Buradaki iki değişken
# YALNIZCA arka plan worker'ının ÇALIŞMA ZAMANLAMASINI kontrol eder
# (bkz. app/services/ldap_scheduler.py) — Celery/broker YOK, mevcut
# app/snmp/scheduler.py ile aynı desen.
# LDAP_SCHEDULED_SYNC_ENABLED=true
# LDAP_SYNC_HOUR=2

# Faz 50 — PAM Oturum Kaydı (Session Recording, yalnızca RDP). guacd
# RDP oturumlarını KENDİSİ `.guac` dosyasına yazar (bkz. apps/api/app/
# pam/guacd.py::recording_config) — bu backend dosyayı YAZMAZ, yalnızca
# AYNI dizini (infra/docker-compose.yml'deki bind mount sayesinde)
# `GET /api/pam/audit/{id}/recording` ile SUNAR. İkisi de set
# EDİLMEDİĞİ sürece kayıt SESSİZCE devre dışı kalır (opt-in — mevcut
# `ENABLE_REMOTE_COMMANDS` ilkesiyle aynı).
#
# GUACD_RECORDING_PATH: guacd konteynerinin KENDİ dosya sisteminden
# gördüğü yol — infra/docker-compose.yml'deki guacd volume mount'unun
# SAĞ tarafıyla (":" sonrası) BİREBİR eşleşmeli.
# GUACD_RECORDING_PATH=/var/log/pam/recordings
#
# PAM_RECORDING_HOST_DIR: bu backend'in AYNI dizini kendi çalışma
# dizininden (apps/api) gördüğü GÖRELİ yol — infra/docker-compose.yml'deki
# guacd volume mount'unun SOL tarafı (`../apps/api/logs/recordings`) bunun
# FİZİKSEL olarak AYNI klasörü işaret etmesi gerekir (backend `apps/api`
# içinden çalıştırıldığı için `./logs/recordings` = `apps/api/logs/
# recordings`).
# PAM_RECORDING_HOST_DIR=./logs/recordings

# Faz 74 — PAM RDP Sürücü Yönlendirme (Dosya Transferi, opt-in). Set
# EDİLMEDİĞİ sürece sürücü paylaşımı SESSİZCE devre dışı kalır — yalnızca
# guacd'nin KENDİ dosya sisteminden gördüğü yol (infra/docker-compose.
# yml'deki guacd volume mount'unun SAĞ tarafıyla BİREBİR eşleşmeli);
# backend bu dizini kendi tarafından AYRICA görmesine gerek YOK
# (yalnızca guacd/RDP oturumu içine erişiyor).
# GUACD_DRIVE_PATH=/var/pam/drives

# Faz 52 — LDAP Bind-Auth Girişi (opt-in). Faz 49'un kendi kararı
# ("gerçek LDAP SSO/bind-auth login KASITLI kapsam dışı") kullanıcının
# açık isteğiyle burada BİLİNÇLİ olarak genişletildi. GERÇEK bir risk:
# açıldığında, senkronize edilmiş (Ayarlar > Active Directory / LDAP >
# "Şimdi Senkronize Et") HERHANGİ bir AD hesabı bu sisteme OTOMATİK bir
# yerel hesapla giriş yapabilir — varsayılan KAPALI.
# LDAP_AUTH_ENABLED=false
#
# LDAP_AUTH_DEFAULT_ROLE: otomatik provizyon edilen AD kullanıcılarının
# başlangıç rolü. Kullanıcının önerdiği `OPERATOR` YERİNE `VIEWER`
# varsayılan — üç rolün en düşük yetkilisi, admin gerekirse `/pam/
# users`'tan elle yükseltir. `ADMIN`/`OPERATOR`/`VIEWER` dışında bir
# değer sessizce `VIEWER`'a düşer.
# LDAP_AUTH_DEFAULT_ROLE=VIEWER

# ============================================================
# Faz 65/66 — Bilet E-Posta Bildirimi (SMTP). Opt-in: `SMTP_SERVER`
# ayarlanmazsa e-posta servisi tamamen no-op (bilet akışını hiçbir
# şekilde etkilemez). smtplib (stdlib) — yeni bağımlılık yok.
#
# Faz 66 — bu değerler artık Ayarlar > "E-Posta Bildirimi (SMTP)"
# ekranından da (DB'de, `smtp_config` tablosu) yönetilebilir.
# `email_service.py` ÖNCE DB satırını, yoksa aşağıdaki `.env`
# değerlerini kullanır. DB'den yönetiyorsanız bunları boş bırakın.
# ============================================================
# SMTP_SERVER=smtp.sirket.local
# SMTP_PORT=587
# SMTP_ENCRYPTION: tls (STARTTLS, tipik 587) | ssl (baştan itibaren
# şifreli, tipik 465) | none (düz metin). Eski `SMTP_USE_TLS` (true/
# false) hâlâ okunur (yalnızca SMTP_ENCRYPTION set edilmemişse) — yeni
# kurulumlar SMTP_ENCRYPTION kullanmalı.
# SMTP_ENCRYPTION=tls
# SMTP_USERNAME=itops-bildirim@sirket.local
# SMTP_PASSWORD=degistir
# SMTP_FROM_EMAIL=itops-bildirim@sirket.local
# SMTP_FROM_NAME=IT Operations Helpdesk
# SMTP_IT_GROUP_EMAIL=it-destek@sirket.local
# TICKET_BASE_URL=https://itops.sirket.local

# ============================================================
# Faz 71 — Zamanlanmış Ağ Taraması worker'ı (varsayılan açık).
# Zamanlamaların kendisi Ayarlar > "Zamanlanmış Taramalar" ekranından
# yönetilir (DB'de) — burada yalnızca worker'ın kendisi kapatılabilir.
# ============================================================
# DISCOVERY_SCHEDULER_ENABLED=true
# DISCOVERY_SCHEDULER_TICK_SECONDS=60
