# Opsiyonel — normalde SET ETMEYİN. Boş bırakıldığında frontend backend'e
# göreli `/api/...` yollarıyla konuşur (bkz. `next.config.ts::rewrites()`,
# sunucu tarafında gerçek backend'e proxy'ler) ve RDP/SSH/Agent indirme
# linkleri sayfanın kendi hostname'ini (LAN IP dahil) + port 8000
# kullanarak otomatik çözülür — bu, hem `localhost`'tan hem de LAN
# üzerinden başka bir IP'den (ör. http://10.0.213.30:3000) erişimde
# doğru çalışır.
#
# Yalnızca backend GERÇEKTEN farklı bir host/portta çalışıyorsa
# (ör. ayrı bir sunucu/konteyner) burada mutlak URL'sini belirtin.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js dev sunucusu varsayılan olarak yalnızca kendi başlatıldığı
# hostname'den (localhost) gelen istekleri kabul eder — LAN üzerinden
# başka bir IP ile açtığınızda (next.config.ts) burada virgülle ayrılmış
# ek origin'ler belirtin. Varsayılan: "10.0.213.30".
# NEXT_ALLOWED_DEV_ORIGINS=10.0.213.30,10.0.213.31

# rewrites() proxy'sinin backend'i bulduğu adres — yalnızca backend
# Next.js dev sunucusuyla AYNI makinede DEĞİLSE değiştirin.
# BACKEND_INTERNAL_URL=http://localhost:8000
