##############################################################################
# IT Operations Assistant — Agent — örnek/referans systemd unit dosyası.
#
# ARTIK OTOMATİK ÜRETİLİYOR — bkz. `apps/agent/scripts/
# install_linux_service.sh` (root/sudo ile çalıştırın; kullanıcı/venv/
# kurulum dizini oluşturma + bu dosyanın GERÇEK path'lerle bir kopyasını
# `/etc/systemd/system/itops-agent.service`'e yazma + `systemctl
# daemon-reload/enable/start` hepsini otomatik yapar). Bu dosya
# yalnızca REFERANS/dokümantasyon amaçlı elle tutuluyor — install
# script'i kendi unit içeriğini kendisi üretir, ikisi arasında elle
# senkron tutma GEREKMEZ (script'in ürettiği içerik BİREBİR bu
# şablonla aynı yapıdadır).
#
# Elle kaldırmak için: `apps/agent/scripts/uninstall_linux_service.sh`.
##############################################################################

[Unit]
Description=IT Operations Assistant Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=itops-agent
Group=itops-agent
WorkingDirectory=/opt/itops-agent
EnvironmentFile=/opt/itops-agent/.env
ExecStart=/opt/itops-agent/.venv/bin/python -m agent start
Restart=always
RestartSec=5

# Sertleştirme (kurulumun izin verdiği ölçüde) — agent'ın kendi state
# dosyası dışında dosya sistemine yazma ihtiyacı yok.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/itops-agent

[Install]
WantedBy=multi-user.target
