# IT Operations Assistant Agent — yapılandırma örneği.
# Bu dosyayı `.env` olarak kopyalayın ve gerçek değerlerinizi girin.
# `.env` asla commit edilmez (bkz. kök .gitignore).

# Backend'in adresi (zorunlu).
BACKEND_URL=http://10.0.213.30:8000

# AGENT_ID/AGENT_TOKEN boş bırakılırsa agent ilk çalıştığında kendi
# kendine kayıt olur (POST /api/agents/register) ve aldığı kimliği
# yerel bir state dosyasına (AGENT_STATE_FILE) kaydeder — bir sonraki
# çalıştırmalarda tekrar kayıt OLMAZ. Bu ikisini yalnızca kimliği
# elle/başka bir yolla önceden biliyorsanız doldurun.
AGENT_ID=
AGENT_TOKEN=

# İLK kayıt için ZORUNLU (Faz 31) — backend'in Settings > Agent
# Configuration bölümünden "Kod Üret" ile alın (10 dakika geçerli, tek
# kullanımlık). Zaten kayıtlı bir agent için (AGENT_ID/AGENT_TOKEN
# doluysa veya yerel state dosyası varsa) HİÇ gerekmez. Bir credential
# DEĞİLDİR — yalnızca "bu kaydı bir insan başlattı" onayıdır.
ENROLLMENT_CODE=

# Döngü aralıkları (saniye).
HEARTBEAT_INTERVAL=30
TELEMETRY_INTERVAL=30
INVENTORY_INTERVAL=300

# Backend'e HTTPS ile bağlanırken sertifika doğrulaması. Production'da
# HER ZAMAN true kalmalı — yalnızca geliştirme ortamında, self-signed
# bir sertifikayla test ederken false yapın.
VERIFY_TLS=true

# Bir inventory turunda gönderilecek en yoğun (CPU/memory) process
# sayısı üst sınırı.
MAX_PROCESSES_REPORTED=50

# Kendi kendine kayıt sonrası agent_id/token'ın saklanacağı yerel
# dosya. Göreli bir yol verilirse çalışma dizinine göre çözülür.
AGENT_STATE_FILE=.itops-agent-state.json

# `start` komutunun konsola EK OLARAK loglayacağı boyut sınırlı
# (rotating, 5MB x 3 yedek) dosya — Windows Servisi/systemd daemon
# olarak çalışırken konsol çıktısı kaybolur/kimse bakmaz. Boş
# bırakılırsa makul bir varsayılan kullanılır (Windows'ta EXE'nin
# kendi dizininde, dev modda çalışma dizininde `agent.log`).
AGENT_LOG_FILE=

# Windows Update taraması (yalnızca Windows, Linux'ta yok sayılır) —
# birincil yöntem COM (`Microsoft.Update.Session`, bekleyen
# güncellemeler), COM başarısız olursa PowerShell `Get-CimInstance
# Win32_QuickFixEngineering`'e (ZATEN KURULMUŞ hotfix'ler — farklı bir
# anlam, bkz. agent/collectors/windows_updates.py) düşer. Varsayılan
# AÇIK — salt-okunur bir tarama, hiçbir OS durumunu DEĞİŞTİRMEZ.
ENABLE_WINDOWS_UPDATES_SCAN=true
# Saniye. Varsayılan 6 saat (21600) — COM `Search()` gerçek bir
# Windows Update sunucusu isteği yapabilir, sık çalıştırılmamalı.
WINDOWS_UPDATES_INTERVAL=21600
